# -----------------------------------------------------------------------------
# Application BASE URL
# https://mksaas.com/docs/env#core-configuration
# For production, set to your domain, e.g. https://mksaas.com
# For development, set to http://localhost:3000 or any other port
# For payment test env, you can try https://hostc.dev for proxy
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# NEXT_PUBLIC_BASE_URL="https://xxx.hostc.dev/"

# -----------------------------------------------------------------------------
# Database
# https://mksaas.com/docs/database
# -----------------------------------------------------------------------------
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Better Auth
# https://mksaas.com/docs/auth
# Generate a random string for the secret key using `openssl rand -base64 32`
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Github OAuth
# https://mksaas.com/docs/auth#2-configure-github-oauth
# https://www.better-auth.com/docs/authentication/github
# Get Client information from https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Google OAuth
# https://mksaas.com/docs/auth#3-configure-google-oauth
# https://www.better-auth.com/docs/authentication/google
# Get Client information from https://console.cloud.google.com/apis/credentials
# Local redirect URI usually looks like:
# http://127.0.0.1:3001/api/auth/callback/google
# Check the exact current value at GET /api/auth/health
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Email / Newsletter (Resend)
# https://mksaas.com/docs/email
# https://mksaas.com/docs/newsletter
# Get API key from https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Newsletter (Beehiiv)
# https://mksaas.com/docs/newsletter
# Get API key from https://app.beehiiv.com/settings/integrations
# -----------------------------------------------------------------------------
BEEHIIV_API_KEY=""
BEEHIIV_PUBLICATION_ID=""

# -----------------------------------------------------------------------------
# Storage (ThumbAI uploads: reference images, generated thumbnails, user assets)
# Recommended for launch: Cloudflare R2 with a public custom domain.
# https://mksaas.com/docs/storage
# Cloudflare R2: https://www.cloudflare.com/developer-platform/products/r2
# R2 endpoint format: https://<account-id>.r2.cloudflarestorage.com
# Check readiness after setup: GET /api/storage/health
# -----------------------------------------------------------------------------
STORAGE_REGION="auto"
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
# Optional but recommended for public thumbnail URLs:
# e.g. https://cdn.thumbai.com or an R2 public bucket/custom domain URL
STORAGE_PUBLIC_URL=""

# -----------------------------------------------------------------------------
# Payment Provider
# ThumbAI is configured to use Creem by default.
# Options: 'stripe' | 'creem'
# Controls which payment provider is used and which price/product IDs are read
# Check readiness after setup: GET /api/payment/health
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENT_PROVIDER="creem"

# -----------------------------------------------------------------------------
# Payment (Stripe)
# https://mksaas.com/docs/payment
# Get Stripe key and secret from https://dashboard.stripe.com
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Pro plan - monthly subscription
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=""
# Pro plan - yearly subscription
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=""
# Max plan - monthly subscription
NEXT_PUBLIC_STRIPE_PRICE_MAX_MONTHLY=""
# Max plan - yearly subscription
NEXT_PUBLIC_STRIPE_PRICE_MAX_YEARLY=""

# -----------------------------------------------------------------------------
# Payment (Creem) - recommended for ThumbAI
# https://docs.creem.io
# Set NEXT_PUBLIC_PAYMENT_PROVIDER='creem' to enable
# Get API key and webhook secret from https://creem.io dashboard
# CREEM_DEBUG=true uses test-api.creem.io (sandbox); false uses production
# -----------------------------------------------------------------------------
CREEM_DEBUG="true"
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# Pro plan - monthly subscription (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_PRO_MONTHLY=""
# Pro plan - yearly subscription (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_PRO_YEARLY=""
# Max plan - monthly subscription (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_MAX_MONTHLY=""
# Max plan - yearly subscription (Creem product id)
NEXT_PUBLIC_CREEM_PRODUCT_MAX_YEARLY=""

# -----------------------------------------------------------------------------
# Configurations
# -----------------------------------------------------------------------------
# Disable image optimization, check out next.config.ts for more details
# -----------------------------------------------------------------------------
DISABLE_IMAGE_OPTIMIZATION=false
# -----------------------------------------------------------------------------
# Run this website as demo website, in most cases, you should set this to false
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_WEBSITE=false

# -----------------------------------------------------------------------------
# Analytics
# https://mksaas.com/docs/analytics
# -----------------------------------------------------------------------------
# Google Analytics (https://analytics.google.com)
# https://mksaas.com/docs/analytics#google
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
# -----------------------------------------------------------------------------
# Umami Analytics (https://umami.is)
# https://mksaas.com/docs/analytics#umami
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT="https://cloud.umami.is/script.js"
# -----------------------------------------------------------------------------
# OpenPanel Analytics (https://openpanel.dev)
# https://mksaas.com/docs/analytics#openpanel
# -----------------------------------------------------------------------------
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=""
# -----------------------------------------------------------------------------
# Plausible Analytics (https://plausible.io)
# https://mksaas.com/docs/analytics#plausible
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"
# -----------------------------------------------------------------------------
# Ahrefs Analytics (https://ahrefs.com)
# https://mksaas.com/docs/analytics#ahrefs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AHREFS_WEBSITE_ID=""
# -----------------------------------------------------------------------------
# Seline Analytics
# https://mksaas.com/docs/analytics#seline
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SELINE_TOKEN=""
# -----------------------------------------------------------------------------
# DataFast Analytics (https://datafa.st)
# https://mksaas.com/docs/analytics#datafast
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=""
NEXT_PUBLIC_DATAFAST_DOMAIN=""
# -----------------------------------------------------------------------------
# PostHog Analytics (https://posthog.com)
# https://mksaas.com/docs/analytics#posthog
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
# -----------------------------------------------------------------------------
# Clarity Analytics (https://clarity.microsoft.com)
# https://mksaas.com/docs/analytics#clarity
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLARITY_PROJECT_ID=""


# -----------------------------------------------------------------------------
# Notification (Discord)
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""
# -----------------------------------------------------------------------------
# Notification (Feishu)
# -----------------------------------------------------------------------------
FEISHU_WEBHOOK_URL=""

# -----------------------------------------------------------------------------
# Affiliate
# https://mksaas.com/docs/affiliate
# -----------------------------------------------------------------------------
# Affonso
# https://affonso.com/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_AFFONSO_ID=""
# -----------------------------------------------------------------------------
# PromoteKit
# https://www.promotekit.com/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_PROMOTEKIT_ID=""

# -----------------------------------------------------------------------------
# Captcha (Cloudflare Turnstile)
# https://mksaas.com/docs/captcha
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Crisp
# https://mksaas.com/docs/chatbox
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CRISP_WEBSITE_ID=""

# -----------------------------------------------------------------------------
# Credit distribution via Cron Jobs
# https://mksaas.com/docs/cronjobs
# -----------------------------------------------------------------------------
CRON_JOBS_USERNAME=""
CRON_JOBS_PASSWORD=""

# -----------------------------------------------------------------------------
# AI
# https://mksaas.com/docs/ai
# -----------------------------------------------------------------------------
# DeepSeek: https://platform.deepseek.com/api_key
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=""
# -----------------------------------------------------------------------------
# OpenAI GPT: https://platform.openai.com/api-key
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""

# -----------------------------------------------------------------------------
# ThumbAI Image Generation
# Provider options: "mock" | "replicate"
# Keep "mock" for local UI/product testing. Use "replicate" after adding a token
# and choosing a Replicate image model with an owner/model path.
# Replicate predictions API: https://replicate.com/docs/reference/http#predictions.create
# -----------------------------------------------------------------------------
THUMBAI_GENERATION_PROVIDER="mock"
REPLICATE_API_TOKEN=""
REPLICATE_IMAGE_MODEL=""
# Live provider safety controls.
# Keep guest live generation disabled until billing, credits, and abuse controls are ready.
THUMBAI_ALLOW_GUEST_LIVE_GENERATION="false"
THUMBAI_LIVE_GUEST_LIMIT_PER_HOUR="1"
THUMBAI_LIVE_USER_LIMIT_PER_HOUR="10"

# -----------------------------------------------------------------------------
# Web Content Analyzer (Firecrawl)
# https://firecrawl.dev/
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=""
